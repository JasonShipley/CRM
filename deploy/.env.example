TAG=v2.29.0
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<generate: openssl rand -hex 24>
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379
SERVER_URL=https://crm.yourdomain.com
ENCRYPTION_KEY=<generate: openssl rand -base64 32>
STORAGE_TYPE=local

# Gmail sync (see README.md "Connect Gmail" for how to get these from Google Cloud)
AUTH_GOOGLE_ENABLED=true
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=<from Google Cloud Console>
AUTH_GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
AUTH_GOOGLE_CALLBACK_URL=https://crm.usemce.com/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.usemce.com/auth/google-apis/get-access-token
