TAG=v2.29.0
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<generate: openssl rand -hex 24>
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379
SERVER_URL=https://crm.yourdomain.com
ENCRYPTION_KEY=<generate: openssl rand -base64 32>
STORAGE_TYPE=local

# Quote builder (renderer). Signs the sign-in cookie — REQUIRED, or every
# restart signs everybody out.
RENDERER_SECRET_KEY=<generate: openssl rand -hex 32>

# MCE's own email domains. Anyone at one signs in as staff with no setup, and
# may issue themselves an API token. Dealers are added in the app (People).
# Blank means usemce.com.
ALLOWED_EMAIL_DOMAINS=

# Mail for the sign-in codes — REQUIRED now that everyone, dealers included,
# signs in with an emailed code. Without SMTP_HOST the code only lands in the
# service log. SMTP_FROM defaults to quotes@<first allowed domain>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Lets the quote builder read a typed-out job description ("quote Dennis at
# Fairview a 4430 with 200hp..."). Get one at console.anthropic.com.
# Without it that one box is disabled; everything else works.
ANTHROPIC_API_KEY=

# The voice assistant (ElevenLabs). The key stays on this server; browsers get
# a short-lived conversation token. Agent ID is "MCE Quote Assistant" in the
# ElevenLabs dashboard. Without both, the mic button says voice is off.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
