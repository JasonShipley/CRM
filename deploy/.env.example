TAG=v2.29.0
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<generate: openssl rand -hex 24>
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379
SERVER_URL=https://crm.yourdomain.com
ENCRYPTION_KEY=<generate: openssl rand -base64 32>
STORAGE_TYPE=local

# Quote builder (renderer). Both optional — Caddy already enforces basic auth.
# Set them together to add a second, app-level password.
RENDERER_PASSWORD=
RENDERER_SECRET_KEY=<generate: openssl rand -hex 32>

# Self-service API tokens for the sales team and the AI agents. Anyone at these
# domains can issue themselves a token at /api/tokens/request; everyone else is
# refused before a code is generated. Blank means usemce.com.
ALLOWED_EMAIL_DOMAINS=

# Mail for the one-time codes. WITHOUT SMTP_HOST the code lands in the service
# log instead of an inbox, which works for issuing the first token by hand but
# is not self-service. SMTP_FROM defaults to quotes@<first allowed domain>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Lets the quote builder read a typed-out job description ("quote Dennis at
# Fairview a 4430 with 200hp..."). Get one at console.anthropic.com.
# Without it that one box is disabled; everything else works.
ANTHROPIC_API_KEY=
