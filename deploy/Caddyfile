# MCE CRM — Caddy reverse proxy with automatic HTTPS (Let's Encrypt)
# crm.usemce.com    -> Twenty CRM
# quotes.usemce.com -> quote renderer

crm.usemce.com {
	reverse_proxy server:3000
}

quotes.usemce.com {
	# The app is the gate. Everyone signs in at /login with a code emailed to
	# them (renderer/accounts.py): MCE staff by work address, dealers once MCE
	# has added them. Agents use bearer tokens. A shared basic-auth password in
	# front would have to be handed to every dealer, so there isn't one — every
	# page and API refuses a request with no session or token (renderer/app.py
	# _gate, tests/test_accounts.py).
	reverse_proxy quote-renderer:8090
}
